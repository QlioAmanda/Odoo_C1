<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Membuat Form View Custom yang sangat sederhana khusus untuk POS -->
    <record id="view_partner_form_pos_simplified" model="ir.ui.view">
        <field name="name">res.partner.pos.form.simplified</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form string="Customer" class="pos_custom_partner_form">
                <sheet>
                    <div class="custom_form_container">
                        <div class="custom_field">
                            <label for="name" class="custom_label"/>
                            <field name="name" default_focus="1" placeholder="e.g. John Doe" required="1"/>
                        </div>
                        <div class="custom_field">
                            <label for="phone" class="custom_label"/>
                            <field name="phone" widget="phone" placeholder="e.g. 08123456789"/>
                        </div>
                        <div class="custom_field">
                            <label for="email" class="custom_label"/>
                            <field name="email" widget="email" placeholder="e.g. pelanggan@email.com"/>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- 2. Mengoverride Action POS bawaan agar menggunakan Form View baru di atas -->
    <record id="point_of_sale.res_partner_action_edit_pos" model="ir.actions.act_window">
        <field name="view_id" ref="view_partner_form_pos_simplified"/>
    </record>
</odoo>
